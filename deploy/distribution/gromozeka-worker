#!/usr/bin/env bash
set -euo pipefail

app_home="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
export GROMOZEKA_HOME="${GROMOZEKA_HOME:-$HOME/.gromozeka}"
export GROMOZEKA_BROWSER_MCP_LAUNCHER="${GROMOZEKA_BROWSER_MCP_LAUNCHER:-$app_home/bin/gromozeka-browser-mcp}"
export GROMOZEKA_BROWSER_MCP_HOME="${GROMOZEKA_BROWSER_MCP_HOME:-$app_home/app/browser-mcp}"
worker_config="${GROMOZEKA_WORKER_CONFIG:-$GROMOZEKA_HOME/worker.yaml}"

case "${1:-}" in
  install-service)
    shift
    exec "$app_home/bin/gromozeka-worker-service" install "$@"
    ;;
  uninstall-service)
    shift
    exec "$app_home/bin/gromozeka-worker-service" uninstall "$@"
    ;;
  start-service)
    shift
    exec "$app_home/bin/gromozeka-worker-service" start "$@"
    ;;
  stop-service)
    shift
    exec "$app_home/bin/gromozeka-worker-service" stop "$@"
    ;;
  service-status)
    shift
    exec "$app_home/bin/gromozeka-worker-service" status "$@"
    ;;
  open-computer-use-permissions)
    shift
    exec "$app_home/bin/gromozeka-worker-service" open-permissions "$@"
    ;;
esac

java_executable="$app_home/runtime/java/bin/java"
[[ -x "$java_executable" ]] || java_executable="$app_home/runtime/java/Contents/Home/bin/java"
[[ -x "$java_executable" ]] || {
  echo "Bundled Java runtime is missing: $app_home/runtime/java" >&2
  exit 2
}

if [ "${1:-}" = "enroll" ]; then
  exec "$java_executable" \
    -jar "$app_home/app/gromozeka-worker.jar" \
    "$@"
fi

exec "$java_executable" \
  -jar "$app_home/app/gromozeka-worker.jar" \
  "--spring.config.additional-location=optional:file:$worker_config" \
  "$@"
