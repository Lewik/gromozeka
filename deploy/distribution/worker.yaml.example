gromozeka:
  worker-gateway:
    enabled: true
    server-url: ${GROMOZEKA_SERVER_URL}
    credential: ${GROMOZEKA_WORKER_GATEWAY_CREDENTIAL}
    ca-certificate-path: ${GROMOZEKA_SERVER_CA_CERTIFICATE_PATH:}
  runtime:
    worker:
      id: workstation
      version: manual
      capabilities:
        - AI_REQUEST_RESPONSE
        - TOOL_EXECUTION
        - LOCAL_AGENT_TOOL
        - COMPUTER_USE
