GROMOZEKA_VERSION=latest
GROMOZEKA_PUBLIC_HOST=gromozeka.example.com
GROMOZEKA_CADDY_CONFIG=Caddyfile
GROMOZEKA_TLS_CERTIFICATE_FILE=server.crt
GROMOZEKA_TLS_PRIVATE_KEY_FILE=server.key
GROMOZEKA_MCP_ALLOWED_HOSTS=gromozeka.example.com
GROMOZEKA_WORKER_ENROLLMENT_ENABLED=true
POSTGRES_PASSWORD=replace-with-a-long-random-password
