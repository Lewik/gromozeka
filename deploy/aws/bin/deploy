#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/aws-common"

require_command gh

repository="${GITHUB_REPOSITORY:-Lewik/gromozeka}"
branch="${GITHUB_DEPLOY_BRANCH:-main}"

if [[ "$#" -ne 1 ]]; then
  echo "Usage: deploy VERSION" >&2
  exit 2
fi

version="${1#v}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || {
  echo "VERSION must be a published semantic Gromozeka release version" >&2
  exit 2
}

gh release view "v$version" \
  --repo "$repository" \
  >/dev/null

gh workflow run deploy-release.yml \
  --repo "$repository" \
  --ref "$branch" \
  --field version="$version"

sleep 3
run_id="$(
  gh run list \
    --repo "$repository" \
    --workflow deploy-release.yml \
    --branch "$branch" \
    --event workflow_dispatch \
    --limit 1 \
    --json databaseId \
    --jq '.[0].databaseId'
)"

printf 'GitHub Actions run: https://github.com/%s/actions/runs/%s\n' "$repository" "$run_id"
gh run watch "$run_id" --repo "$repository" --exit-status
