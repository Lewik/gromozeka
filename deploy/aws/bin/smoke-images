#!/usr/bin/env bash

set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
run_id="$$"
network="gromozeka-cloud-smoke-$run_id"
postgres="gromozeka-smoke-postgres-$run_id"
server="gromozeka-smoke-server-$run_id"
worker="gromozeka-smoke-worker-$run_id"
platform="${GROMOZEKA_CLOUD_PLATFORM:-linux/amd64}"
server_image="${GROMOZEKA_SERVER_IMAGE:-gromozeka/server:local}"
worker_image="${GROMOZEKA_WORKER_IMAGE:-gromozeka/worker:local}"
log_dir="$root_dir/logs/cloud-image-smoke"

mkdir -p "$log_dir"

capture_logs() {
  docker logs "$server" > "$log_dir/server.log" 2>&1 || true
  docker logs "$worker" > "$log_dir/worker.log" 2>&1 || true
}

cleanup() {
  status=$?
  trap - EXIT
  capture_logs
  docker rm -f "$worker" "$server" "$postgres" >/dev/null 2>&1 || true
  docker network rm "$network" >/dev/null 2>&1 || true
  if [[ "$status" -ne 0 ]]; then
    tail -100 "$log_dir/server.log" >&2 || true
    tail -100 "$log_dir/worker.log" >&2 || true
  fi
  exit "$status"
}

trap cleanup EXIT

docker network create "$network" >/dev/null
docker run -d \
  --name "$postgres" \
  --network "$network" \
  --network-alias postgres \
  -e POSTGRES_DB=gromozeka \
  -e POSTGRES_USER=gromozeka \
  -e POSTGRES_PASSWORD=smoke \
  pgvector/pgvector:0.8.6-pg16@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b >/dev/null

for attempt in {1..60}; do
  if docker exec "$postgres" pg_isready -U gromozeka -d gromozeka >/dev/null 2>&1; then
    break
  fi
  [[ "$attempt" != 60 ]] || {
    echo "Disposable PostgreSQL did not become ready." >&2
    exit 1
  }
  sleep 2
done

server_environment=(
  -e GROMOZEKA_MODE=prod
  -e GROMOZEKA_POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/gromozeka
  -e GROMOZEKA_POSTGRES_USERNAME=gromozeka
  -e GROMOZEKA_POSTGRES_PASSWORD=smoke
)

docker run -d \
  --platform "$platform" \
  --name "$server" \
  --network "$network" \
  --tmpfs /var/lib/gromozeka:uid=10001,gid=10001 \
  -p 127.0.0.1::8765 \
  "${server_environment[@]}" \
  "$server_image" >/dev/null

host_port="$(
  docker inspect "$server" \
    --format '{{(index (index .NetworkSettings.Ports "8765/tcp") 0).HostPort}}'
)"

for attempt in {1..90}; do
  server_state="$(docker inspect "$server" --format '{{.State.Status}}')"
  if [[ "$server_state" != "running" ]]; then
    echo "Server container stopped during startup: server=$server_state" >&2
    exit 1
  fi
  if curl --fail --silent "http://127.0.0.1:$host_port/" | grep -qi "<html"; then
    break
  fi
  [[ "$attempt" != 90 ]] || {
    echo "Server did not serve the packaged Web client." >&2
    exit 1
  }
  sleep 2
done

worker_gateway_credential="smoke-worker-gateway-credential-0000000000000001"
worker_gateway_hash="$(
  printf '%s' "$worker_gateway_credential" \
    | sha256sum \
    | awk '{print $1}'
)"
docker exec "$postgres" \
  psql -U gromozeka -d gromozeka -v ON_ERROR_STOP=1 \
  -c "INSERT INTO users(id, username, display_name, status, created_at, updated_at)
      VALUES ('smoke-user', 'smoke-user', 'Smoke User', 'ACTIVE', now(), now());
      INSERT INTO workers(id, display_name, owner_user_id, runtime_wide_access, status, created_at, updated_at)
      VALUES ('cloud-primary', 'Cloud Primary', 'smoke-user', true, 'ACTIVE', now(), now());
      INSERT INTO worker_gateway_credentials(worker_id, credential_hash, created_at, rotated_at)
      VALUES ('cloud-primary', '$worker_gateway_hash', now(), now());" >/dev/null

docker run -d \
  --platform "$platform" \
  --name "$worker" \
  --network "container:$server" \
  --tmpfs /var/lib/gromozeka:uid=10001,gid=10001 \
  -e GROMOZEKA_MODE=prod \
  -e GROMOZEKA_SERVER_URL=http://127.0.0.1:8765 \
  -e GROMOZEKA_WORKER_GATEWAY_CREDENTIAL="$worker_gateway_credential" \
  -e GROMOZEKA_RUNTIME_WORKER_ID=cloud-primary \
  -e GROMOZEKA_RUNTIME_WORKER_VERSION=smoke \
  -e GROMOZEKA_RUNTIME_WORKER_CAPABILITIES=AI_REQUEST_RESPONSE,TOOL_EXECUTION,LOCAL_AGENT_TOOL \
  "$worker_image" >/dev/null

worker_registrations=0
server_health="starting"
for attempt in {1..90}; do
  server_state="$(docker inspect "$server" --format '{{.State.Status}}')"
  worker_state="$(docker inspect "$worker" --format '{{.State.Status}}')"
  if [[ "$server_state" != "running" ]]; then
    echo "Server container stopped while waiting for Worker registration: server=$server_state" >&2
    exit 1
  fi
  if [[ "$worker_state" != "running" ]]; then
    echo "Worker container stopped during startup: worker=$worker_state" >&2
    exit 1
  fi
  server_health="$(docker inspect "$server" --format '{{.State.Health.Status}}')"
  worker_registrations="$(
    docker exec "$postgres" \
      psql -U gromozeka -d gromozeka -Atc \
      "select count(*) from conversation_runtime_workers where worker_id = 'cloud-primary';"
  )"
  if [[ "$worker_registrations" == "1" && "$server_health" == "healthy" ]]; then
    break
  fi
  [[ "$attempt" != 90 ]] || {
    echo "Server or Worker did not become healthy: server=$server_health registrations=$worker_registrations" >&2
    exit 1
  }
  sleep 2
done

server_state="$(docker inspect "$server" --format '{{.State.Status}}')"
server_health="$(docker inspect "$server" --format '{{.State.Health.Status}}')"
worker_state="$(docker inspect "$worker" --format '{{.State.Status}}')"

[[ "$server_state" == "running" && "$server_health" == "healthy" ]]
[[ "$worker_state" == "running" ]]
[[ "$worker_registrations" == "1" ]]

printf 'server=%s health=%s worker=%s registrations=%s\n' \
  "$server_state" \
  "$server_health" \
  "$worker_state" \
  "$worker_registrations"
