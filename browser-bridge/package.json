{
  "name": "@gromozeka/browser-bridge",
  "version": "0.2.0",
  "description": "Connect Gromozeka Browser Use to every ordinary tab in an existing Chromium profile",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lewik/gromozeka.git",
    "directory": "browser-bridge"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "build": "npm run clean && npm run typecheck && vite build --clearScreen=false",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "3.4.0",
    "vitest": "4.1.10"
  }
}
