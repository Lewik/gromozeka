{
  "manifest_version": 3,
  "name": "Gromozeka Browser Bridge",
  "short_name": "Gromozeka Bridge",
  "version": "0.1.0",
  "description": "Connect Gromozeka Browser Use to ordinary tabs in this Chromium profile.",
  "permissions": [
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Gromozeka Browser Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
